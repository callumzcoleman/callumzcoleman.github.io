#!/usr/bin/env python3
"""Build an interactive Oxford innovation map from JSON pin data."""

from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
INPUT_PATH = ROOT / "scripts" / "oxford_innovation_points.json"
OUTPUT_PATH = ROOT / "artifacts" / "oxford_innovation_map.html"

THEME_COLORS = {
    "Health": "#D7263D",
    "Health / AI": "#F46036",
    "Health / Genomics": "#F6AE2D",
    "Health / Materials research": "#F6AE2D",
    "Energy / Materials": "#1B998B",
    "Clean Energy": "#2E8B57",
    "Clean energy": "#2E8B57",
    "Quantum / Computing": "#6A4C93",
    "Cybersecurity": "#1D3557",
    "Scientific instruments / Imaging": "#457B9D",
    "Science infrastructure": "#264653",
    "Innovation districts": "#8D99AE",
    "Advanced Manufacturing / Materials": "#3A86FF",
    "Life Sciences tools": "#8338EC",
}

TYPE_LAYERS = {
    "University institute": "University",
    "Company": "Companies",
    "Campus": "National infrastructure",
    "National facility": "National infrastructure",
    "Place hub": "National infrastructure",
}


def _popup_html(point: dict[str, str]) -> str:
    return "".join(
        [
            '<div style="font-family: Inter, Arial, sans-serif; max-width: 350px;">',
            f"<h3 style='margin:0 0 6px 0;'>{point['name']}</h3>",
            f"<p style='margin:0 0 4px 0;'><b>Type:</b> {point['type']}</p>",
            f"<p style='margin:0 0 4px 0;'><b>Theme:</b> {point['impact_theme']}</p>",
            f"<p style='margin:0 0 4px 0;'><b>Anchor:</b> {point['place_anchor']}</p>",
            f"<p style='margin:0 0 8px 0;'><b>Address:</b> {point['address']}, {point['city']} {point['postcode']}</p>",
            f"<p style='margin:0 0 8px 0;'>{point['human_benefit_one_liner']}</p>",
            f"<p style='margin:0 0 8px 0; color:#374151;'><b>Scale marker:</b> {point['funding_or_scale_marker']}</p>",
            f"<p style='margin:0 0 8px 0; color:#4b5563;'><i>Note:</i> {point['notes']}</p>",
            f"<a href='{point['website']}' target='_blank' rel='noopener noreferrer'>Website</a>",
            "</div>",
        ]
    )


def build_map() -> None:
    points = json.loads(INPUT_PATH.read_text(encoding="utf-8"))

    marker_js_by_layer: dict[str, list[str]] = {
        "University": [],
        "Companies": [],
        "National infrastructure": [],
    }
    legend_items = []

    seen_themes: set[str] = set()
    for point in points:
        theme = point["impact_theme"]
        color = THEME_COLORS.get(theme, "#6B7280")
        if theme not in seen_themes:
            legend_items.append(
                f"<li><span style='display:inline-block;width:10px;height:10px;border-radius:50%;background:{color};margin-right:8px;'></span>{theme}</li>"
            )
            seen_themes.add(theme)

        popup = _popup_html(point).replace("`", "'")
        layer = TYPE_LAYERS.get(point["type"], "National infrastructure")
        marker_js_by_layer[layer].append(
            """
            const marker = L.circleMarker([{lat}, {lon}], {{
                radius: 7,
                color: '{color}',
                fillColor: '{color}',
                fillOpacity: 0.85,
                weight: 1.5
            }});
            marker.bindPopup(`{popup}`);
            marker.addTo({layer_var});
            bounds.push([{lat}, {lon}]);
            """.format(
                lat=point["lat"],
                lon=point["lon"],
                color=color,
                popup=popup,
                layer_var=layer.lower().replace(" ", "_"),
            )
        )

    html = f"""<!DOCTYPE html>
