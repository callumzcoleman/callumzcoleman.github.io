      "National infrastructure": national_infrastructure
    }};
    L.control.layers(null, layers, {{collapsed: false}}).addTo(map);

    const bounds = [];
    {''.join(marker_js_by_layer['University'])}
    {''.join(marker_js_by_layer['Companies'])}
    {''.join(marker_js_by_layer['National infrastructure'])}

